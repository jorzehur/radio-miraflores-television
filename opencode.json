{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "forge",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4000
  },
  "instructions": [
    ".opencode/rules/project-rules.md",
    ".opencode/context/**/*.md"
  ],
  "permission": {
    "bash": "ask",
    "edit": "ask"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  }
}
