# GitHub Token para commits del admin (Git como CMS)
# Obtén tu token en: https://github.com/settings/tokens
# Necesita permisos: repo (full control)
GITHUB_TOKEN=ghp_your_token_here

# Repositorio de GitHub (formato: usuario/repo)
GITHUB_REPO=jorzehur/radio-miraflores-television

# Rama principal del repositorio
GITHUB_BRANCH=main

# Credenciales del panel de administración
ADMIN_EMAIL=admin@radiomiraflores.com
ADMIN_PASSWORD=admin123
